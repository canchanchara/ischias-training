{
  "name": "ischias-training",
  "version": "1.0.0",
  "private": true,
  "description": "Web-App mit täglich wechselndem Trainingsplan bei Ischiasschmerzen – Timer, animierte Übungen, Musik.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:docker": "docker run --rm -v \"$PWD\":/app -w /app node:22-alpine node --test tests/*.test.js",
    "serve:docker": "docker run --rm -p 8080:80 -v \"$PWD\":/usr/share/nginx/html:ro nginx:alpine"
  }
}
